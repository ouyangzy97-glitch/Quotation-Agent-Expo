{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "description": "\u6240\u5c5e\u4f1a\u8bdd"
    },
    "role": {
      "type": "string",
      "enum": [
        "user",
        "assistant"
      ],
      "description": "user / assistant"
    },
    "text": {
      "type": "string",
      "description": "\u6d88\u606f\u6587\u672c"
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "\u7ed3\u6784\u5316\u5361\u7247\uff1arecognition / diff / script / run"
    },
    "attachment_name": {
      "type": "string",
      "description": "\u9644\u4ef6\u6587\u4ef6\u540d"
    }
  },
  "required": [
    "session_id",
    "role"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    }
  }
}